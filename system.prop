#
# system.prop for the Meizu M2 Note (m2note, M571) — LineageOS 16.0
#
# Layout follows the m5c LOS 16 file (on this no-first-stage-mount layout the
# only prop file early init reads is /system/build.prop).  Values are the
# m2note's own: live getprop of the running 15.1 build (capture
# runtime/v212_live_20260620-080956/getprop.txt) and the LOS 15.1 m2note tree.
#

# --- Platform identity -------------------------------------------------------
# FACT (live getprop): [ro.board.platform]: [mt6753], [ro.hardware]: [mt6735].
ro.board.platform=mt6753
ro.mediatek.platform=MT6753
ro.mediatek.chip_ver=S01
ro.mediatek.version.sdk=4
ro.mediatek.version.release=alps-mp-m0.mp1-V2.39.1_wtk6753.65u.m0_P16
# FACT (live getprop): [ro.hardware.gps]: [m2note] — no gps.m2note.so exists,
# hw_get_module falls through to ro.board.platform (gps.mt6753.so).  Kept as
# measured.  ro.hardware.power=mt6753: 15.1 value; no power.mt6753 module is
# built in this tree (the 15.1 source island power/ is not carried yet).
ro.hardware.gps=m2note
ro.hardware.power=mt6753

# --- MTK combo chip ----------------------------------------------------------
persist.mtk.wcn.combo.chipid=0x0337
persist.mtk.wcn.fwlog.status=0
service.wcn.driver.ready=no
persist.mtk.combo.coredump=no

# --- Telephony (dual SIM, LTE) ------------------------------------------------
# HONEST NOTE: on 15.1 telephony was broken (gsm.sim.state=ABSENT,ABSENT with a
# live modem, M2NOTE_SUBSYSTEM_STATUS_2026-07-06.md:60), and the last proven
# boot ran with m2note.disable_md1=1.  These are configuration, not evidence.
rild.libpath=/vendor/lib64/mtk-ril.so
rild.libargs=-d /dev/ttyC0
ro.telephony.sim.count=2
ro.telephony.default_network=20,20
persist.radio.multisim.config=dsds
persist.radio.default.sim=0
persist.radio.mobile.data=0,0
persist.radio.fd.counter=15
persist.radio.fd.off.counter=5
persist.radio.fd.r8.counter=15
persist.radio.fd.off.r8.counter=5
ril.current.share_modem=2
ril.external.md=0
ril.telephony.mode=0
ril.specific.sm_cause=0
ro.mtk_enable_md1=1
ro.mtk_lte_support=1
ro.mtk_gemini_support=1
ro.mtk_gemini_enhancement=1
persist.gemini.sim_num=2
ro.gemini.smart_sim_switch=false
ro.telephony.ril.config=fakeiccid

# --- Wi-Fi --------------------------------------------------------------------
mediatek.wlan.chip=CONSYS_MT6735
mediatek.wlan.module.postfix=_consys_mt6735
ro.mediatek.wlan.wsc=1
ro.mediatek.wlan.p2p=1
mediatek.wlan.ctia=0
ro.mtk_wlan_support=1
wifi.tethering.interface=wlan0
wifi.interface=wlan0
wifi.direct.interface=p2p0
wifi.supplicant_scan_interval=180

ro.mtk_bt_support=1
ro.mtk_gps_support=1
ro.mtk_agps_app=1
fmradio.driver.enable=0
net.tethering.noprovisioning=true

# --- Graphics -----------------------------------------------------------------
ro.opengles.version=196609
# FACT (live getprop): [ro.sf.lcd_density]: [420]; panel nt35532_fhd_dsi_vdo_sharp
# mounted upside down (15.1 tree: ro.sf.hwrotation=180).
ro.sf.lcd_density=420
ro.sf.hwrotation=180
# Capacitive/hardware keys; the 15.1 build ran with mainkeys=1 and mBack works
# (INPUT-MBACK = good, M2NOTE_SUBSYSTEM_STATUS_2026-07-06.md:51).
qemu.hw.mainkeys=1
# FACT on THIS handset (M2NOTE_FULL_ROM_ASSESSMENT_2026-07-02.md, "BOOTLOOP
# ЗИПА"): debug.hwui.use_buffer_age=true bootlooped the consolidated ROM
# (~160 s hang, wdt reboot); false booted clean and held >500 s.
debug.hwui.use_buffer_age=false
# Mali-T720 partial-update tearing (m5c lesson).  Name checked against
# frameworks/base @a1553b93f0 libs/hwui/Properties.h:152.
debug.hwui.use_partial_updates=false

# --- Media / DRM / camera -------------------------------------------------------
drm.service.enabled=true
ro.mtk_widevine_drm_l3_support=1
media.stagefright.legacyencoder=true
media.stagefright.less-secure=true
camera.disable_zsl_mode=1

# --- USB -------------------------------------------------------------------------
ro.sys.usb.storage.type=mtp
ro.sys.usb.mtp.whql.enable=0
ro.sys.usb.bicr=no
ro.sys.usb.charging.only=yes

# --- Audio -------------------------------------------------------------------------
ro.camera.sound.forced=0
ro.audio.silent=0
ro.mtk_audio_ape_support=1
# m5c lesson; INFERENCE that the M-era mt6753 HAL has the same unset
# get_capture_position (hardware/interfaces @e45e6f6e StreamIn.impl.h:449 reads it).
ro.audio.legacy_hal_no_capture_position=1

# --- Misc ----------------------------------------------------------------------------
ro.zygote.preload.enable=0
ro.kernel.zio=38,108,105,16
# FACT (live 15.1): ro.frp.pst=/dev/block/mmcblk0p20 — frp IS p20 on this GPT
# (by-name list); written by name here (no partition numbers rule).
ro.frp.pst=/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/frp
