# M2 Note legacy android_usb + FunctionFS setup.
# Board evidence: m2note_defconfig CONFIG_USB_G_ANDROID=y; no USB_CONFIGFS.
# Actions derived from this board's own 15.1/A9 init.mt6735.usb.rc:23-28.
# AOSP init.usb.rc owns the sys.usb.config=adb triggers and adbd service.
on fs
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    write /sys/class/android_usb/android0/f_ffs/aliases adb
