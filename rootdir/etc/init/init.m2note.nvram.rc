# init.m2note.nvram.rc — NVRAM-dependent fixes carried over from the m95
# bring-up (meizu-fleet/BRINGUP_STATE.md 2026-09-24).
#
# Only the Bluetooth-address lesson applies here.  The fstab copy that m5c,
# m5s and m95 need does NOT: this libnvram never reads /data/nvram/fstab.%s
# (FACT, strings of vendor/meizu/m2note/proprietary/vendor/lib{,64}/
# libnvram.so: it opens /dev/block/platform/mtk-msdc.0/by-name/nvram directly,
# and nvram_daemon has no "cp fstab*").
#
# service.nvram_init=Ready: set by nvram_daemon (FACT, strings of
# proprietary/vendor/bin/nvram_daemon: "service.nvram_init").  Its stock rc
# (proprietary/vendor/etc/init/nvram_daemon.rc, excluded from the image with
# the other Oreo rc files) starts it only on sys.boot_completed=1 or
# vold.decrypt=trigger_restart_framework, so on this device the trigger
# below fires late; the HAL needs the address only when Bluetooth is enabled.

# Bluetooth address from NVRAM (m95 lesson, device/meizu/m95 15d2dc9).
# The AOSP BT HAL of this tree aborts with "No Bluetooth Address!" unless an
# address property is set (hardware/interfaces/bluetooth/1.0/default/
# vendor_interface.cc:217); m2note-bdaddr.sh publishes the NVRAM one as
# persist.service.bdroid.bdaddr.  The HAL (user bluetooth) also reads BT_Addr
# itself through libnvram (FACT: libbluetooth_mtk.so NEEDED libnvram.so),
# hence the regroup.  Both wait for NVRAM's own Ready flag: nvram_daemon
# restores BT_Addr only after post-fs-data, and on m95 the publisher, started
# earlier, found no file on a fresh /data and the HAL aborted ("Open: No
# Bluetooth Address!", tombstone_18).
# No seclabel and no domain yet: in permissive mode init only logs the missing
# transition and runs the script in init's domain
# (system/core/init/service.cpp:97-100).  An enforcing build needs a domain,
# as m95 has (seclabel u:r:m95_bdaddr:s0).
service m2note_bdaddr /vendor/bin/sh /vendor/bin/m2note-bdaddr.sh
    class core
    user root
    group root bluetooth
    oneshot
    disabled

on property:service.nvram_init=Ready
    chown root bluetooth /data/nvram/APCFG/APRDEB/BT_Addr
    chmod 0660 /data/nvram/APCFG/APRDEB/BT_Addr
    start m2note_bdaddr
