# forge m5c: device half of the P configfs USB gadget (stage-2/3 gap).
# The generic ramdisk init.usb.configfs.rc only DRIVES an existing gadget;
# creating g1 + ffs.adb + functionfs mount is the device rc's job (cf. m681
# init.mt6755.usb.rc). Vendor rc files are parsed during mount_all ("on fs"),
# so use post-fs - it queues after parsing.
# usb-shell 2026-08-29: musb ffs AIO wedges bulk-IN (usbmon-proven) - adbd goes
# deaf to every service OPEN until a host-side USB reset; force legacy r/w path.
on post-fs
    setprop sys.usb.ffs.aio_compat 1
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee7
    mkdir /config/usb_gadget/g1/strings/0x409 0770
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer meizu
    write /config/usb_gadget/g1/strings/0x409/product m5c
    mkdir /config/usb_gadget/g1/configs/b.1 0770
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
